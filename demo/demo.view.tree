$bog_selection_demo $mol_page
	title \$bog_selection
	body /
		<= Hint $mol_paragraph
			title <= hint_text \
		<= Article $bog_selection_demo_text
			text <= article \
		<= List $bog_selection_demo_list
			rows <= rows /
			text <= list_text \
		<= Paste $mol_textarea
			hint \Вставь сюда, чтобы проверить буфер
			value? <=> paste? \
	Row* $mol_paragraph
		title <= row_title* \

$bog_selection_demo_text $mol_text
	plugins /
		<= Selection $bog_selection
			text <= text

$bog_selection_demo_list $mol_list
	text \
	plugins /
		<= Selection $bog_selection
			text <= text
