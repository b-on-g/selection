$bog_selection_demo $mol_page
	title \$bog_selection
	body /
		<= Hint $mol_paragraph
			title <= hint_text \
		<= Article $mol_text
			text <= article \
			plugins /
				<= Article_selection $bog_selection
					text <= article
		<= List $mol_list
			rows <= rows /
			plugins /
				<= List_selection $bog_selection
					text <= list_text \
		<= Paste $mol_textarea
			hint \Вставь сюда, чтобы проверить буфер
			value? <=> paste? \
	Row* $mol_paragraph
		title <= row_title* \
